#!/usr/bin/env bash
# .agent/scripts/adapter
# Project-type adapter dispatcher (ADR-0011).
#
# Resolves the active project type and dispatches a verb to that type's
# adapter implementation in .agent/project_types/<type>/adapter.sh.
#
# Usage:
#   .agent/scripts/adapter [--from <dir>] [--project <name>] <verb> [args...]
#
# Verbs (the adapter contract — see REQUIRED_VERBS below):
#   setup           First-time bring-up: clone, layer import, post-install hooks
#   sync            Pull updates across constituent repos / refresh layers
#   validate        Check checkout shape matches what the type expects
#   build           Invoke the project's build
#   test            Invoke the project's tests
#   install         Deploy / install the built artifact
#   env             Emit shell statements callers eval (e.g., ROS overlay)
#   project_root    Print the path to the project tree
#   repos           Print newline-separated name:path for each constituent repo
#   scope_for_pr    Given a path, print owner/repo for PR targeting
#   worktree_repos  Print <origin>\t<rel_path_in_worktree>\t<branch> per repo
#                   to worktree for an issue (ADR-0012)
#   worktree_env    Print sourceable bash (or nothing) for a package worktree
#                   built by worktree_repos (ADR-0012)
#
# `adapter env` output protocol: each stdout line is a complete shell
# statement; callers eval the whole stdout. Example caller:
#   eval "$(.agent/scripts/adapter env)"
# A type with no environment to expose emits nothing (and exits 0).
#
# Multi-tenant resolution (#172 step 2, issue #227) — the active project is
# resolved in this order:
#   1. --project <name>: explicit selection from .agent/projects.local
#   2. --from <dir> (default: caller's cwd) inside a registered hosting dir
#   3. Legacy: PROJECT_TYPE from .agent/project_config.sh, root project/
# `--project` and `--from` are extracted from argv wherever they appear, so
# shims can forward them after the verb (no contract verb takes flags with
# these names). The resolved project is exposed to the sourced adapter as
# shell variables (not exported): ACTIVE_PROJECT_NAME (empty for legacy),
# ACTIVE_PROJECT_ROOT, ACTIVE_PROJECT_FILE (the per-project settings file
# .agent/projects.d/<name>, issue #332; grammar in _project_registry.sh),
# ACTIVE_PROJECT_BUILD / _TEST / _INSTALL / _BOOTSTRAP_URL (its keys; empty
# when unset), and ACTIVE_PROJECT_CONFIG (the legacy per-project config
# .agent/projects.d/<name>.sh). Per setting, adapters read the settings-file
# variable first, then the legacy file's variable, then the shared
# .agent/project_config.sh, and say so on stderr when a registered project
# falls through to the shared file. A malformed settings file stops every
# verb.
#
# Contract requirements for .agent/project_types/<type>/adapter.sh:
#   - Silent at source time: nothing written to stdout while being sourced
#     (machine-read verbs like `env` are eval'd by callers; source-time
#     output would corrupt them). Enforced by validate_adapter.sh.
#   - No top-level `exit`: the file defines functions only.
#
# .agent/project_config.sh must be side-effect-free (plain variable
# assignments): it is sourced once here for PROJECT_TYPE resolution and
# again by verbs that need command variables.
#
# This file is sourceable: sourcing defines REQUIRED_VERBS and
# _resolve_project_type without dispatching (used by validate_adapter.sh).

set -euo pipefail

# Single source of truth for the contract. validate_adapter.sh imports this.
REQUIRED_VERBS=(setup sync validate build test install env project_root repos scope_for_pr worktree_repos worktree_env)

_ADAPTER_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$(dirname "$_ADAPTER_SCRIPT_DIR")")"

# Print the legacy project type. Reads PROJECT_TYPE from
# .agent/project_config.sh; defaults to single_project so pre-adapter
# configs (BUILD_CMD/TEST_CMD only) keep working unchanged.
# Registry-resolved projects take their type from .agent/projects.local
# instead (see the dispatch section below).
_resolve_project_type() {
    local config="$WORKSPACE_ROOT/.agent/project_config.sh"
    local project_type="single_project"
    if [ -f "$config" ]; then
        local configured
        configured="$(
            # Subshell so config vars don't leak into the dispatcher.
            # Clear any inherited PROJECT_TYPE first: only the config file
            # may select the type, not the caller's environment.
            PROJECT_TYPE=
            # shellcheck source=/dev/null
            source "$config" >/dev/null 2>&1 || true
            echo "${PROJECT_TYPE:-}"
        )"
        [ -n "$configured" ] && project_type="$configured"
    fi
    echo "$project_type"
}

# Sourced (not executed): stop here so callers get the definitions above.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# shellcheck source=_project_registry.sh
source "$_ADAPTER_SCRIPT_DIR/_project_registry.sh"

usage() {
    echo "Usage: adapter [--from <dir>] [--project <name>] <verb> [args...]" >&2
    echo "Verbs: ${REQUIRED_VERBS[*]}" >&2
}

# Extract --from/--project wherever they appear so shims that append flags
# after the verb (build.sh --project x → adapter build --project x) work.
FROM_DIR=""
PROJECT_ARG=""
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --from)
            [ $# -ge 2 ] || { echo "ERROR: --from requires a directory argument" >&2; usage; exit 1; }
            FROM_DIR="$2"
            shift 2
            ;;
        --project)
            [ $# -ge 2 ] || { echo "ERROR: --project requires a project name" >&2; usage; exit 1; }
            PROJECT_ARG="$2"
            shift 2
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# ---------------------------------------------------- user-tier guard (#265) ---
# This script is promoted to the user tier (.agent/user_tier_scripts.txt), so
# it can be invoked from any cwd on the machine. Refuse outside the workspace
# checkout and outside every registered project root, BEFORE any repo action.
#
# The guard runs AFTER argument parsing, on the EFFECTIVE directory
# (--from <dir>, else $PWD), because that is the directory this invocation
# will actually resolve a project from. Guarding $PWD instead got it wrong
# in both directions: `adapter --from /unrelated build` run from the
# workspace passed the guard and then operated on an unrelated directory,
# while a legitimate `adapter --from <workspace-or-root> build` run from
# somewhere else was refused for a cwd it was never going to use. See
# docs/decisions/0016-session-roots-and-the-user-tier.md.
# A --from that does not exist is not a root to guard on: the discovery
# below already falls back to the workspace root for it, so the guard does
# the same rather than refusing on a directory nobody will read.
_GUARD_DIR="$PWD"
[ -n "$FROM_DIR" ] && [ -d "$FROM_DIR" ] && _GUARD_DIR="$FROM_DIR"
registry_require_root "$WORKSPACE_ROOT" "$_GUARD_DIR" || exit 1
set -- ${ARGS[@]+"${ARGS[@]}"}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

VERB="$1"
shift

verb_known=false
for v in "${REQUIRED_VERBS[@]}"; do
    [ "$v" = "$VERB" ] && verb_known=true
done
if [ "$verb_known" != true ]; then
    echo "ERROR: unknown verb '$VERB'" >&2
    usage
    exit 1
fi

# --- Resolve the active project (issue #227) ---
# ACTIVE_PROJECT_* are read by the sourced adapter's functions (like
# WORKSPACE_ROOT/ADAPTER_TYPE_DIR below), hence the SC2034 disables.
ACTIVE_PROJECT_NAME=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_ROOT="$WORKSPACE_ROOT/project"
# shellcheck disable=SC2034
ACTIVE_PROJECT_CONFIG=""
PROJECT_TYPE_NAME=""

if [ -n "$PROJECT_ARG" ]; then
    # Explicit selection by registered name.
    _RC=0
    _ENTRY="$(registry_lookup "$WORKSPACE_ROOT" "$PROJECT_ARG")" || _RC=$?
    if [ "$_RC" -ne 0 ]; then
        if [ "$_RC" -eq 1 ]; then
            echo "ERROR: project '$PROJECT_ARG' is not registered in $(registry_file "$WORKSPACE_ROOT")" >&2
            _NAMES="$(registry_names "$WORKSPACE_ROOT" 2>/dev/null || true)"
            if [ -n "$_NAMES" ]; then
                echo "Registered projects:" >&2
                sed 's/^/  /' <<< "$_NAMES" >&2
            else
                echo "  (no projects registered — see .agent/projects.local.example)" >&2
            fi
        fi
        exit 1
    fi
    ACTIVE_PROJECT_NAME="$PROJECT_ARG"
    PROJECT_TYPE_NAME="$(cut -f1 <<< "$_ENTRY")"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_ROOT="$(cut -f2 <<< "$_ENTRY")"
else
    # Discovery: resolve from the caller's directory (or --from <dir>).
    _FROM="${FROM_DIR:-$PWD}"
    if _ENTRY="$(registry_resolve_from_dir "$WORKSPACE_ROOT" "$_FROM")"; then
        ACTIVE_PROJECT_NAME="$(cut -f1 <<< "$_ENTRY")"
        PROJECT_TYPE_NAME="$(cut -f2 <<< "$_ENTRY")"
        # shellcheck disable=SC2034
        ACTIVE_PROJECT_ROOT="$(cut -f3 <<< "$_ENTRY")"
    else
        _RC=$?
        [ "$_RC" -eq 2 ] && exit 1  # malformed registry — never guess
        # Inside the hosting dir but not registered → fail loud rather than
        # silently operating on the legacy project.
        _WSROOT_P="$(cd "$WORKSPACE_ROOT" && pwd -P)"
        _FROM_P="$(cd "$_FROM" 2>/dev/null && pwd -P || true)"
        if [ -n "$_FROM_P" ] && [[ "$_FROM_P" == "$_WSROOT_P/projects/"* ]]; then
            echo "ERROR: $_FROM_P is under projects/ but no registered project owns it." >&2
            echo "Register it in $(registry_file "$WORKSPACE_ROOT") (see .agent/projects.local.example)." >&2
            exit 1
        fi
        # Legacy: project/ symlink + workspace-level config.
        PROJECT_TYPE_NAME="$(_resolve_project_type)"
    fi
fi

# A parent root (pseudo-type "project", #265) has no adapter: operate on its
# default_instance, or its only instance; several without a default is an
# error that lists them.
if [ "$PROJECT_TYPE_NAME" = "$REGISTRY_PARENT_TYPE" ] && [ -n "$ACTIVE_PROJECT_NAME" ]; then
    _INSTANCE="$(registry_default_instance "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")" || exit 1
    _ENTRY="$(registry_lookup "$WORKSPACE_ROOT" "$_INSTANCE")" || {
        echo "ERROR: instance '$_INSTANCE' of '$ACTIVE_PROJECT_NAME' is not registered" >&2
        exit 1
    }
    ACTIVE_PROJECT_NAME="$_INSTANCE"
    PROJECT_TYPE_NAME="$(cut -f1 <<< "$_ENTRY")"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_ROOT="$(cut -f2 <<< "$_ENTRY")"
fi

# shellcheck disable=SC2034
ACTIVE_PROJECT_ROLE=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_DISTRO=""
if [ -n "$ACTIVE_PROJECT_NAME" ]; then
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_CONFIG="$WORKSPACE_ROOT/.agent/projects.d/${ACTIVE_PROJECT_NAME}.sh"
    # Registry trailing fields (#265); adapters read these as shell variables.
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_ROLE="$(registry_field "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" role 2>/dev/null || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_DISTRO="$(registry_field "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" distro 2>/dev/null || true)"
fi

# --- Per-project settings file (issue #332) ---
# .agent/projects.d/<name>, parsed once here. A malformed file, or records
# settings that are refused (a records repository that is a workspace),
# stop every verb: never resolve silently. Records settings that are valid
# but not yet honoured (#393) are reported by project_setting.sh check, not
# here. Adapters read the command and URL keys as these variables and fall
# back, per setting, to the legacy ACTIVE_PROJECT_CONFIG variable, then the
# shared .agent/project_config.sh. Empty means "not set in the file"; the
# value 'none' is a recorded "this project has none".
ACTIVE_PROJECT_FILE=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_BUILD=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_TEST=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_INSTALL=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_BOOTSTRAP_URL=""
if [ -n "$ACTIVE_PROJECT_NAME" ]; then
    ACTIVE_PROJECT_FILE="$(project_file_path "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")"
    if ! _PF_ENTRIES="$(project_file_entries "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")"; then
        echo "ERROR: project '$ACTIVE_PROJECT_NAME': its settings file $ACTIVE_PROJECT_FILE is invalid (errors above); fix it, then check it with .agent/scripts/project_setting.sh check $ACTIVE_PROJECT_NAME" >&2
        exit 1
    fi
    _PF_RC=0
    _PF_MSG="$(_project_records_check_entries "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" "$_PF_ENTRIES" 2>&1 >/dev/null)" || _PF_RC=$?
    if [ "$_PF_RC" -eq 2 ]; then
        printf '%s\n' "$_PF_MSG" >&2
        echo "ERROR: project '$ACTIVE_PROJECT_NAME': records settings in $ACTIVE_PROJECT_FILE are refused (above)" >&2
        exit 1
    fi
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_BUILD="$(_project_file_value_of "$_PF_ENTRIES" build || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_TEST="$(_project_file_value_of "$_PF_ENTRIES" test || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_INSTALL="$(_project_file_value_of "$_PF_ENTRIES" install || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_BOOTSTRAP_URL="$(_project_file_value_of "$_PF_ENTRIES" bootstrap_url || true)"
fi

# Run a command value from the project file: split on blanks into argv and
# exec it without a shell and without globbing (the parser has already
# refused quotes and shell operators). Extra arguments are appended.
# Usage: active_project_exec "$ACTIVE_PROJECT_BUILD" "$@"
active_project_exec() {
    local -a _argv=()
    read -r -a _argv <<< "$1"
    shift
    exec "${_argv[@]}" "$@"
}

# The note printed when a registered project's command comes from the
# shared .agent/project_config.sh rather than its own settings: that
# fallback used to be silent (issue #332).
# Usage: active_project_fallback_note build
active_project_fallback_note() {
    [ -n "${ACTIVE_PROJECT_NAME:-}" ] || return 0
    echo "NOTE: project '$ACTIVE_PROJECT_NAME' has no $1 command of its own; using the shared .agent/project_config.sh (set it with: .agent/scripts/project_setting.sh set $ACTIVE_PROJECT_NAME $1=<command>, or $1=none)" >&2
}

ADAPTER_TYPE_DIR="$WORKSPACE_ROOT/.agent/project_types/$PROJECT_TYPE_NAME"

if [ ! -f "$ADAPTER_TYPE_DIR/adapter.sh" ]; then
    echo "ERROR: no adapter for project type '$PROJECT_TYPE_NAME'" >&2
    echo "  expected: $ADAPTER_TYPE_DIR/adapter.sh" >&2
    exit 1
fi

# Deliberately NOT exported: the sourced adapter's functions read these as
# shell variables, and exporting them would leak new names into the
# environment of every BUILD_CMD/TEST_CMD/INSTALL_CMD child process — an
# observable difference from the pre-adapter scripts.

# shellcheck source=/dev/null
source "$ADAPTER_TYPE_DIR/adapter.sh"

if ! declare -F "adapter_${VERB}" >/dev/null; then
    echo "ERROR: project type '$PROJECT_TYPE_NAME' does not implement verb '$VERB'" >&2
    echo "  (run .agent/scripts/validate_adapter.sh to check the contract)" >&2
    exit 1
fi

"adapter_${VERB}" "$@"
