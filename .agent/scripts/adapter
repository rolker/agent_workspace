#!/usr/bin/env bash
# .agent/scripts/adapter
# Project-type adapter dispatcher (ADR-0011).
#
# Resolves the active project type and dispatches a verb to that type's
# adapter implementation in .agent/project_types/<type>/adapter.sh.
#
# Usage:
#   .agent/scripts/adapter [--from <dir>] [--project <name>] <verb> [args...]
#
# Verbs (the adapter contract — see REQUIRED_VERBS below):
#   setup           First-time bring-up: clone, layer import, post-install hooks
#   sync            Pull updates across constituent repos / refresh layers
#   validate        Check checkout shape matches what the type expects
#   build           Invoke the project's build
#   test            Invoke the project's tests
#   install         Deploy / install the built artifact
#   env             Emit shell statements callers eval (e.g., ROS overlay)
#   project_root    Print the path to the project tree
#   repos           Print newline-separated name:path for each constituent repo
#   scope_for_pr    Given a path, print owner/repo for PR targeting
#   worktree_repos  Print <origin>\t<rel_path_in_worktree>\t<branch> per repo
#                   to worktree for an issue (ADR-0012)
#   worktree_env    Print sourceable bash (or nothing) for a package worktree
#                   built by worktree_repos (ADR-0012)
#   repo_pin        Given a repo name [--layer <l>], print <ref>\t<kind>: the
#                   ref the project pins it at and whether that ref is a
#                   branch, tag, commit or unknown (ADR-0019)
#
# `adapter env` output protocol: each stdout line is a complete shell
# statement; callers eval the whole stdout. Example caller:
#   eval "$(.agent/scripts/adapter env)"
# A type with no environment to expose emits nothing (and exits 0).
#
# Multi-tenant resolution (#172 step 2, issue #227) — the active project is
# resolved in this order:
#   1. --project <name>: explicit selection from .agent/projects.local
#   2. --from <dir> (default: caller's cwd) inside a registered hosting dir
#      or in that root's worktrees= folder, wherever it lies
#      (registry_resolve_session_dir)
# Nothing else names a project (issue #265 part 4 retired the project/
# symlink step and its PROJECT_TYPE read): with neither, every verb except
# `sync` refuses with registry_no_project_message, and `sync` syncs the
# workspace alone (see _WORKSPACE_ONLY_SYNC_TYPE below).
# `--project` and `--from` are extracted from argv wherever they appear, so
# shims can forward them after the verb (no contract verb takes flags with
# these names). The resolved project is exposed to the sourced adapter as
# shell variables (not exported): ACTIVE_PROJECT_NAME (empty only for the
# workspace-only sync), ACTIVE_PROJECT_ROOT, ACTIVE_PROJECT_FROM (the
# directory the call comes from, --from <dir> or else the cwd, as a
# physical path), ACTIVE_PROJECT_FILE (the per-project settings file
# .agent/projects.d/<name>, issue #332; grammar in _project_registry.sh),
# ACTIVE_PROJECT_BUILD / _TEST / _INSTALL / _BOOTSTRAP_URL / _SOURCE /
# _SOURCE_REF / _SOURCE_PATH (its keys; empty when unset). The settings file
# is a project's only source of commands and URLs: issue #265 part 4
# retired the legacy .agent/projects.d/<name>.sh and the shared
# .agent/project_config.sh, which no verb reads. A malformed settings file
# stops every verb. ROS_ROOT_DIR is the one value an adapter takes from the
# process environment (ros2_colcon's distro underlay root, default
# /opt/ros; only tests and non-standard installs set it).
#
# Contract requirements for .agent/project_types/<type>/adapter.sh:
#   - Silent at source time: nothing written to stdout while being sourced
#     (machine-read verbs like `env` are eval'd by callers; source-time
#     output would corrupt them). Enforced by validate_adapter.sh.
#   - No top-level `exit`: the file defines functions only.
#
# This file is sourceable: sourcing defines REQUIRED_VERBS without
# dispatching (used by validate_adapter.sh).

set -euo pipefail

# Single source of truth for the contract. validate_adapter.sh imports this.
REQUIRED_VERBS=(setup sync validate build test install env project_root repos scope_for_pr worktree_repos worktree_env repo_pin)

_ADAPTER_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_ROOT="$(dirname "$(dirname "$_ADAPTER_SCRIPT_DIR")")"

# The one type the dispatcher names (issue #265 part 4): `sync` with no
# project resolved syncs the workspace alone, and the code that does that
# (single_project/sync.py with no --project-root) lives in this type. Used
# only for that verb in that case; every other verb with no project refuses.
# ADR-0011 lets the dispatcher pick a default type (its "default:
# single_project"); the workspace adapter type that issue #295's later pull
# request adds replaces this constant as the home of the workspace sync.
_WORKSPACE_ONLY_SYNC_TYPE="single_project"

# Sourced (not executed): stop here so callers get the definitions above.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# shellcheck source=_project_registry.sh
source "$_ADAPTER_SCRIPT_DIR/_project_registry.sh"

# For the type adapters: a git call that asks origin, bounded the way
# wt_bounded_git bounds worktree creation's calls (#323), with the same
# WT_FETCH_TIMEOUT knob (default 60s). GIT_TERMINAL_PROMPT=0 stops an
# HTTPS credential prompt; `timeout` (when installed) also ends an SSH
# passphrase or host-key prompt and a stalled host. The exit status is
# git's, or 124 (137 after the -k grace) when the limit ended it.
# `timeout --foreground` (where this timeout has it) keeps git in the
# caller's process group, so a Ctrl-C reaches git at once instead of
# after the limit. The limit then ends git itself, not programs git
# started: an ssh git started may outlive it, until it notices git is gone
# or, when it is stalled while connecting, until its own connect timeout.
# It holds a pipe to git only, so the caller's command substitution
# returns at the limit and no lock the caller closed for git is held.
# Usage: _adapter_bounded_git -C <repo> ls-remote ...
_adapter_git_limit() {
    local limit="${WT_FETCH_TIMEOUT:-60}"
    [[ "$limit" =~ ^[1-9][0-9]*$ ]] || limit=60
    echo "$limit"
}
_adapter_bounded_git() {
    local -a bound=()
    if command -v timeout >/dev/null 2>&1; then
        if timeout --foreground 5 true >/dev/null 2>&1; then
            bound=(timeout --foreground -k 5 "$(_adapter_git_limit)")
        else
            bound=(timeout -k 5 "$(_adapter_git_limit)")
        fi
    fi
    GIT_TERMINAL_PROMPT=0 ${bound[@]+"${bound[@]}"} git "$@"
}

usage() {
    echo "Usage: adapter [--from <dir>] [--project <name>] <verb> [args...]" >&2
    echo "Verbs: ${REQUIRED_VERBS[*]}" >&2
}

# Extract --from/--project wherever they appear so shims that append flags
# after the verb (build.sh --project x → adapter build --project x) work.
FROM_DIR=""
PROJECT_ARG=""
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --from)
            [ $# -ge 2 ] || { echo "ERROR: --from requires a directory argument" >&2; usage; exit 1; }
            FROM_DIR="$2"
            shift 2
            ;;
        --project)
            [ $# -ge 2 ] || { echo "ERROR: --project requires a project name" >&2; usage; exit 1; }
            PROJECT_ARG="$2"
            shift 2
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done

# ---------------------------------------------------- user-tier guard (#265) ---
# This script is promoted to the user tier (.agent/user_tier_scripts.txt), so
# it can be invoked from any cwd on the machine. Refuse outside the workspace
# checkout and outside every registered project root, BEFORE any repo action.
#
# The guard runs AFTER argument parsing, on the EFFECTIVE directory
# (--from <dir>, else $PWD), because that is the directory this invocation
# will actually resolve a project from. Guarding $PWD instead got it wrong
# in both directions: `adapter --from /unrelated build` run from the
# workspace passed the guard and then operated on an unrelated directory,
# while a legitimate `adapter --from <workspace-or-root> build` run from
# somewhere else was refused for a cwd it was never going to use. See
# docs/decisions/0016-session-roots-and-the-user-tier.md.
# A --from that is not a directory is refused: it names no project, and
# since issue #265 part 4 there is no project/ fallback to resolve to.
if [ -n "$FROM_DIR" ] && [ ! -d "$FROM_DIR" ]; then
    echo "ERROR: --from '$FROM_DIR' is not a directory" >&2
    exit 1
fi
_GUARD_DIR="${FROM_DIR:-$PWD}"
registry_require_root "$WORKSPACE_ROOT" "$_GUARD_DIR" || exit 1
set -- ${ARGS[@]+"${ARGS[@]}"}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

VERB="$1"
shift

verb_known=false
for v in "${REQUIRED_VERBS[@]}"; do
    [ "$v" = "$VERB" ] && verb_known=true
done
if [ "$verb_known" != true ]; then
    echo "ERROR: unknown verb '$VERB'" >&2
    usage
    exit 1
fi

# --- Resolve the active project (issue #227) ---
# ACTIVE_PROJECT_* are read by the sourced adapter's functions (like
# WORKSPACE_ROOT/ADAPTER_TYPE_DIR below), hence the SC2034 disables.
ACTIVE_PROJECT_NAME=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_ROOT=""
PROJECT_TYPE_NAME=""

if [ -n "$PROJECT_ARG" ]; then
    # Explicit selection by registered name.
    _RC=0
    _ENTRY="$(registry_lookup "$WORKSPACE_ROOT" "$PROJECT_ARG")" || _RC=$?
    if [ "$_RC" -ne 0 ]; then
        if [ "$_RC" -eq 1 ]; then
            echo "ERROR: project '$PROJECT_ARG' is not registered in $(registry_file "$WORKSPACE_ROOT")" >&2
            _NAMES="$(registry_names "$WORKSPACE_ROOT" 2>/dev/null || true)"
            if [ -n "$_NAMES" ]; then
                echo "Registered projects:" >&2
                sed 's/^/  /' <<< "$_NAMES" >&2
            else
                # Split-token idiom (issue #295 hub guard): a message is
                # not a read of the registration script.
                echo "  (no projects registered — register one: .agent/scripts/register_project"".sh <path>)" >&2
            fi
        fi
        exit 1
    fi
    ACTIVE_PROJECT_NAME="$PROJECT_ARG"
    PROJECT_TYPE_NAME="$(cut -f1 <<< "$_ENTRY")"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_ROOT="$(cut -f2 <<< "$_ENTRY")"
else
    # Discovery: resolve from the caller's directory (or --from <dir>): its
    # registered root, counting that root's worktrees= folder wherever it
    # lies, as session_root.sh and the worktree scripts do.
    _FROM="${FROM_DIR:-$PWD}"
    if _ENTRY="$(registry_resolve_session_dir "$WORKSPACE_ROOT" "$_FROM")"; then
        ACTIVE_PROJECT_NAME="$(cut -f1 <<< "$_ENTRY")"
        PROJECT_TYPE_NAME="$(cut -f2 <<< "$_ENTRY")"
        # shellcheck disable=SC2034
        ACTIVE_PROJECT_ROOT="$(cut -f3 <<< "$_ENTRY")"
    else
        _RC=$?
        [ "$_RC" -eq 2 ] && exit 1  # malformed registry — never guess
        # No registered root here (issue #265 part 4: no project/ fallback).
        # `sync` syncs the workspace alone; every other verb refuses, naming
        # the directory, the registered projects and the way out.
        if [ "$VERB" = "sync" ]; then
            PROJECT_TYPE_NAME="$_WORKSPACE_ONLY_SYNC_TYPE"
        else
            _FROM_P="$(cd "$_FROM" 2>/dev/null && pwd -P || echo "$_FROM")"
            echo "ERROR: $(registry_no_project_message "$WORKSPACE_ROOT" "$_FROM_P")" >&2
            exit 1
        fi
    fi
fi

# A parent root (pseudo-type "project", #265) has no adapter: operate on its
# default_instance, or its only instance; several without a default is an
# error that lists them.
if [ "$PROJECT_TYPE_NAME" = "$REGISTRY_PARENT_TYPE" ] && [ -n "$ACTIVE_PROJECT_NAME" ]; then
    _INSTANCE="$(registry_default_instance "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")" || exit 1
    _ENTRY="$(registry_lookup "$WORKSPACE_ROOT" "$_INSTANCE")" || {
        echo "ERROR: instance '$_INSTANCE' of '$ACTIVE_PROJECT_NAME' is not registered" >&2
        exit 1
    }
    ACTIVE_PROJECT_NAME="$_INSTANCE"
    PROJECT_TYPE_NAME="$(cut -f1 <<< "$_ENTRY")"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_ROOT="$(cut -f2 <<< "$_ENTRY")"
fi

# The directory the call comes from, physical: --from <dir>, else the cwd,
# in both the --project and the discovery case (ros2_colcon's tool route
# chooses its distro from it; issue 503).
# shellcheck disable=SC2034
ACTIVE_PROJECT_FROM="$(cd "${FROM_DIR:-$PWD}" 2>/dev/null && pwd -P || true)"
# shellcheck disable=SC2034
ACTIVE_PROJECT_ROLE=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_DISTRO=""
if [ -n "$ACTIVE_PROJECT_NAME" ]; then
    # Registry trailing fields (#265); adapters read these as shell variables.
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_ROLE="$(registry_field "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" role 2>/dev/null || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_DISTRO="$(registry_field "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" distro 2>/dev/null || true)"
fi

# --- Per-project settings file (issue #332) ---
# .agent/projects.d/<name>, parsed once here. A malformed file, or records
# settings that are refused (a records repository that is a workspace),
# stop every verb: never resolve silently. Records settings that are valid
# but not yet honoured (#393) are reported by project_setting.sh check, not
# here. Adapters read the command and URL keys as these variables, and
# from nowhere else (issue #265 part 4). Empty means "not set in the
# file"; the value 'none' is a recorded "this project has none".
ACTIVE_PROJECT_FILE=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_BUILD=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_TEST=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_INSTALL=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_BOOTSTRAP_URL=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_SOURCE=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_SOURCE_REF=""
# shellcheck disable=SC2034
ACTIVE_PROJECT_SOURCE_PATH=""
if [ -n "$ACTIVE_PROJECT_NAME" ]; then
    ACTIVE_PROJECT_FILE="$(project_file_path "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")"
    if ! _PF_ENTRIES="$(project_file_entries "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")"; then
        echo "ERROR: project '$ACTIVE_PROJECT_NAME': its settings file $ACTIVE_PROJECT_FILE is invalid (errors above); fix it, then check it with .agent/scripts/project_setting.sh check $ACTIVE_PROJECT_NAME" >&2
        exit 1
    fi
    _PF_RC=0
    _PF_MSG="$(_project_records_check_entries "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" "$_PF_ENTRIES" 2>&1 >/dev/null)" || _PF_RC=$?
    if [ "$_PF_RC" -eq 2 ]; then
        printf '%s\n' "$_PF_MSG" >&2
        echo "ERROR: project '$ACTIVE_PROJECT_NAME': records settings in $ACTIVE_PROJECT_FILE are refused (above)" >&2
        exit 1
    fi
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_BUILD="$(_project_file_value_of "$_PF_ENTRIES" build || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_TEST="$(_project_file_value_of "$_PF_ENTRIES" test || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_INSTALL="$(_project_file_value_of "$_PF_ENTRIES" install || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_BOOTSTRAP_URL="$(_project_file_value_of "$_PF_ENTRIES" bootstrap_url || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_SOURCE="$(_project_file_value_of "$_PF_ENTRIES" source || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_SOURCE_REF="$(_project_file_value_of "$_PF_ENTRIES" source_ref || true)"
    # shellcheck disable=SC2034
    ACTIVE_PROJECT_SOURCE_PATH="$(_project_file_value_of "$_PF_ENTRIES" source_path || true)"
fi

# --- Retired settings files are not silent (issue #265 part 4) ---
# A .agent/projects.d/<name>.sh, or the shared .agent/project_config.sh
# for a project without one (the old resolution order, plan review N3),
# is no longer read. When it still sets something the settings file lacks,
# the verbs a person runs (setup, sync, validate, build, test, install) say
# so on stderr, naming each setting and the command that moves it;
# `install` with no install setting refuses instead of reporting "nothing
# to install" for a command that used to run (plan review N2), and refuses
# too when what the file holds cannot be told (it cannot be sourced, or the
# registry or the settings file has errors): unknown is never read as
# "nothing". Telling what the file holds means sourcing (running) it in a
# subshell, so the machine-read verbs (env, project_root, repos,
# scope_for_pr, worktree_repos, worktree_env, repo_pin), which scripts call
# often and which read no command setting, skip the check; make validate
# and the dashboard still report the file (registry_stale_report).
case "$VERB" in
    setup|sync|validate|build|test|install) _STALE_CHECK=1 ;;
    *) _STALE_CHECK=0 ;;
esac
if [ -n "$ACTIVE_PROJECT_NAME" ] && [ "$_STALE_CHECK" -eq 1 ]; then
    _STALE_FILE="$(registry_stale_config_for "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME")"
    if [ -n "$_STALE_FILE" ]; then
        _STALE_RC=0
        _STALE_LINES="$(registry_stale_settings_lines "$WORKSPACE_ROOT" "$ACTIVE_PROJECT_NAME" "$_STALE_FILE")" || _STALE_RC=$?
        _STALE_REL=".agent/${_STALE_FILE#"$WORKSPACE_ROOT/.agent/"}"
        if [ -n "$_STALE_LINES" ]; then
            if [ "$_STALE_RC" -eq 0 ]; then
                echo "NOTE: project '$ACTIVE_PROJECT_NAME': $_STALE_REL is no longer read (issue #265 part 4), and it still sets:" >&2
            else
                echo "NOTE: project '$ACTIVE_PROJECT_NAME': $_STALE_REL is no longer read (issue #265 part 4), and what it still sets cannot be told:" >&2
            fi
            printf '%s\n' "$_STALE_LINES" | sed 's/^/  /' >&2
        elif [[ "$_STALE_FILE" == *.sh ]] && [ "$_STALE_FILE" != "$WORKSPACE_ROOT/.agent/project_config.sh" ]; then
            echo "NOTE: project '$ACTIVE_PROJECT_NAME': $_STALE_REL is no longer read (issue #265 part 4) and holds nothing left to move: delete it" >&2
        fi
        if [ "$VERB" = install ] && [ -z "$ACTIVE_PROJECT_INSTALL" ]; then
            if [ "$_STALE_RC" -ne 0 ]; then
                echo "ERROR: project '$ACTIVE_PROJECT_NAME' has no install setting, and whether $_STALE_REL holds an install command that is no longer run cannot be told (above): read it, set the command with .agent/scripts/project_setting.sh set $ACTIVE_PROJECT_NAME install=<command> (or install=none), then run install again" >&2
                exit 1
            fi
            if grep -q " sets INSTALL_CMD=" <<< "$_STALE_LINES"; then
                echo "ERROR: project '$ACTIVE_PROJECT_NAME' has no install setting, and the install command in $_STALE_REL is no longer run: set it with .agent/scripts/project_setting.sh set $ACTIVE_PROJECT_NAME install=<command> (or install=none), then run install again" >&2
                exit 1
            fi
        fi
    fi
fi

# Run a command value from the project file: split on blanks into argv and
# exec it without a shell and without globbing (the parser has already
# refused quotes and shell operators). Extra arguments are appended. The
# '--' ends exec's own options, so a first word starting with '-' is the
# command's name (`build=-c make` must not run make with an empty
# environment through exec -c).
# Usage: active_project_exec "$ACTIVE_PROJECT_BUILD" "$@"
active_project_exec() {
    local -a _argv=()
    read -r -a _argv <<< "$1"
    shift
    exec -- "${_argv[@]}" "$@"
}

ADAPTER_TYPE_DIR="$WORKSPACE_ROOT/.agent/project_types/$PROJECT_TYPE_NAME"

if [ ! -f "$ADAPTER_TYPE_DIR/adapter.sh" ]; then
    echo "ERROR: no adapter for project type '$PROJECT_TYPE_NAME'" >&2
    echo "  expected: $ADAPTER_TYPE_DIR/adapter.sh" >&2
    exit 1
fi

# Deliberately NOT exported: the sourced adapter's functions read these as
# shell variables, and exporting them would leak new names into the
# environment of every BUILD_CMD/TEST_CMD/INSTALL_CMD child process — an
# observable difference from the pre-adapter scripts.

# shellcheck source=/dev/null
source "$ADAPTER_TYPE_DIR/adapter.sh"

if ! declare -F "adapter_${VERB}" >/dev/null; then
    echo "ERROR: project type '$PROJECT_TYPE_NAME' does not implement verb '$VERB'" >&2
    echo "  (run .agent/scripts/validate_adapter.sh to check the contract)" >&2
    exit 1
fi

"adapter_${VERB}" "$@"
