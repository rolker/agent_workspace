#!/usr/bin/env bash
# A stand-in for `colcon build` in the tests of `repos-manifest build`. It appends one line
# per run to $STUB_COLCON_LOG: the directory it runs in, the layers sourced before it (the
# `install/setup.bash` it writes adds its layer to STUB_SOURCED), and its arguments. It writes
# `install/setup.bash`, as colcon does even after a failure, and copies the system's
# `.repos-manifest/built.yaml`, as it is while it runs, to $STUB_COLCON_LOG.built-<layer>.
# A repo given in --base-paths with a file STUB_FAIL makes it exit 1; one with STUB_WAIT makes
# it wait until it gets SIGTERM or SIGINT, which it logs, and then exit 143.
set -u
layer=$(basename "$PWD")
log=${STUB_COLCON_LOG:?}
echo "run cwd=$PWD sourced=${STUB_SOURCED:-} args=$*" >>"$log"

top=$PWD
while [ "$top" != / ] && [ ! -d "$top/.repos-manifest" ]; do
    top=$(dirname "$top")
done
if [ -f "$top/.repos-manifest/built.yaml" ]; then
    cp "$top/.repos-manifest/built.yaml" "$log.built-$layer"
else
    : >"$log.built-$layer"
fi

mkdir -p install
printf 'export STUB_SOURCED="${STUB_SOURCED:+$STUB_SOURCED:}%s"\n' "$layer" >install/setup.bash

status=0
paths=0
for arg in "$@"; do
    case $arg in
        --base-paths) paths=1; continue ;;
        --*) paths=0; continue ;;
    esac
    if [ "$paths" = 1 ]; then
        [ -e "$arg/STUB_FAIL" ] && status=1
        if [ -e "$arg/STUB_WAIT" ]; then
            trap 'echo "got TERM" >>"$log"; exit 143' TERM
            trap 'echo "got INT" >>"$log"; exit 130' INT
            echo "waiting" >>"$log"
            while :; do sleep 0.05; done
        fi
    fi
done
exit "$status"
